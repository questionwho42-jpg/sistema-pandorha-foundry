{
  "isCustomSystemExport": true,
  "templates": [],
  "items": [],
  "actors": [
    {
      "type": "_template",
      "name": "Template Ator Pandorha v3.0 (True Mirror)",
      "data": {
        "hidden": [
          { "name": "hp_max_total", "value": "${10 + (fisico + resistencia) * 5}$" },
          { "name": "pv_max_total", "value": "${fisico + interacao + nivel}$" },
          { "name": "ee_max_total", "value": "${mental + resistencia + nivel}$" },
          { "name": "ca_total", "value": "${10 + nivel + resistencia + armadura + escudo}$" },
          { "name": "init_total", "value": "${nivel + mental + interacao}$" },
          { "name": "mov_total", "value": "${9 + fisico}$" },
          { "name": "carga_total", "value": "${fisico + resistencia + 6}$" },
          { "name": "armadura", "value": "0" },
          { "name": "escudo", "value": "0" }
        ],
        "body": {
          "type": "panel",
          "cssClass": "pandorha-actor-body",
          "contents": [
            {
              "key": "main_tabs",
              "type": "tabbedPanel",
              "contents": [
                {
                  "type": "tab", "name": "Página 1", "key": "pg1",
                  "contents": [

                    { "type": "label", "value": "<h2>IDENTIDADE</h2>", "cssClass": "p-section" },
                    {
                      "key": "id_panel", "type": "panel", "label": "Identidade", "cssClass": "pandorha-panel",
                      "contents": [
                        {
                          "type": "table", "cols": 4, "rows": 2,
                          "contents": [
                            [ { "type": "label", "value": "NOME DO PERSONAGEM" }, { "type": "label", "value": "JOGADOR" }, { "type": "label", "value": "CLASSE" }, { "type": "label", "value": "NÍVEL" } ],
                            [ { "key": "nome", "type": "textField" }, { "key": "jogador", "type": "textField" }, { "key": "classe_nome", "type": "textField" }, { "key": "nivel", "type": "numberField", "defaultValue": "1" } ]
                          ]
                        },
                        {
                          "type": "table", "cols": 4, "rows": 2,
                          "contents": [
                            [ { "type": "label", "value": "ANCESTRALIDADE" }, { "type": "label", "value": "ANTECEDENTE" }, { "type": "label", "value": "ESPECIALIZAÇÃO" }, { "type": "label", "value": "XP" } ],
                            [ { "key": "anc_nome", "type": "textField" }, { "key": "ant_nome", "type": "textField" }, { "key": "especial", "type": "textField" }, { "key": "xp", "type": "numberField", "defaultValue": "0" } ]
                          ]
                        }
                      ]
                    },

                    {
                      "type": "table", "cols": 3, "rows": 1,
                      "contents": [
                        [
                          {
                            "key": "eixos_box", "type": "panel", "label": "Eixos", "cssClass": "pandorha-panel",
                            "contents": [
                              {
                                "type": "table", "cols": 3, "rows": 2,
                                "contents": [
                                  [ { "type": "label", "value": "FÍSICO" }, { "type": "label", "value": "MENTAL" }, { "type": "label", "value": "SOCIAL" } ],
                                  [ { "key": "fisico", "type": "numberField", "defaultValue": "1", "cssClass": "stat-value" }, { "key": "mental", "type": "numberField", "defaultValue": "1", "cssClass": "stat-value" }, { "key": "social", "type": "numberField", "defaultValue": "1", "cssClass": "stat-value" } ]
                                ]
                              },
                              { "type": "panel", "flow": "horizontal", "contents": [ { "type": "label", "value": "Bônus racial:" }, { "key": "bn_rac", "type": "textField" } ] },
                              { "type": "label", "value": "6 pontos (mín 1, máx 3 cada)", "size": "small" }
                            ]
                          },
                          {
                            "key": "apps_box", "type": "panel", "label": "Aplicações", "cssClass": "pandorha-panel",
                            "contents": [
                              {
                                "type": "table", "cols": 3, "rows": 2,
                                "contents": [
                                  [ { "type": "label", "value": "CONFLITO" }, { "type": "label", "value": "INTERAÇÃO" }, { "type": "label", "value": "RESISTÊNCIA" } ],
                                  [ { "key": "conflito", "type": "numberField", "defaultValue": "1", "cssClass": "stat-value" }, { "key": "interacao", "type": "numberField", "defaultValue": "1", "cssClass": "stat-value" }, { "key": "resistencia", "type": "numberField", "defaultValue": "1", "cssClass": "stat-value" } ]
                                ]
                              },
                              { "type": "label", "value": "6 pontos (mín 1, máx 3 cada)", "size": "small" }
                            ]
                          },
                          {
                            "key": "recs_box", "type": "panel", "label": "Recursos", "cssClass": "pandorha-panel",
                            "contents": [
