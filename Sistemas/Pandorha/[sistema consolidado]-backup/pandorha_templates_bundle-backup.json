                              { "type": "panel", "contents": [ { "type": "label", "value": "Magia 5" }, { "key": "mag5_n", "type": "textField" }, { "type": "panel", "flow": "horizontal", "contents": [ { "type": "label", "value": "Círculo:" }, { "key": "mag5_c", "type": "numberField" }, { "type": "label", "value": "EE:" }, { "key": "mag5_ee", "type": "numberField" } ] }, { "type": "label", "value": "EFEITO" }, { "key": "mag5_ef", "type": "textArea" } ] },
