                                "type": "table", "cols": 2, "rows": 1,
                                "contents": [
                                  [
                                    { "type": "panel", "contents": [ { "type": "label", "value": "PV" }, { "type": "panel", "flow": "horizontal", "contents": [ { "key": "pv_cur", "type": "numberField", "defaultValue": "3" }, { "type": "label", "value": "/ ${pv_max_total}$" } ] } ] },
                                    { "type": "panel", "contents": [ { "type": "label", "value": "EE" }, { "type": "panel", "flow": "horizontal", "contents": [ { "key": "ee_cur", "type": "numberField", "defaultValue": "3" }, { "type": "label", "value": "/ ${ee_max_total}$" } ] } ] }
                                  ]
                                ]
                              },
                              { "type": "label", "value": "1 PV = +2 em teste", "size": "small" }
                            ]
                          }
                        ]
                      ]
                    },

                    {
                      "key": "def_panel", "type": "panel", "label": "Defesas e Derivados", "cssClass": "pandorha-panel",
                      "contents": [
                        {
                          "type": "table", "cols": 6, "rows": 2,
                          "contents": [
                            [ { "type": "label", "value": "CA" }, { "type": "label", "value": "INICIATIVA" }, { "type": "label", "value": "VELOCIDADE" }, { "type": "label", "value": "CARGA" }, { "type": "label", "value": "PERCEPÇÃO" }, { "type": "label", "value": "CÁLCULOS" } ],
                            [ { "type": "label", "value": "${ca_total}$" }, { "type": "label", "value": "${init_total}$" }, { "type": "label", "value": "${mov_total}$m" }, { "type": "label", "value": "${carga_total}$" }, { "key": "percepcao", "type": "numberField" }, { "type": "label", "value": "CA: 10+Nív+Armad+Resist\nINI: Nív+Mental+Inter\nCarga: (Fís+Res)+6", "size": "small" } ]
                          ]
                        }
                      ]
                    },

